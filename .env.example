NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Web Push (VAPID) - gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<vapid-public-key>"
VAPID_PRIVATE_KEY="<vapid-private-key>"
VAPID_SUBJECT="mailto:contato@exemplo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<mesma-vapid-public-key>"

# Proteção da rota de cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="<segredo-forte>"

# URL pública da aplicação (retornos de pagamento)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<stripe-publishable-key>"

# Asaas (PIX)
ASAAS_API_KEY="<asaas-api-key>"
ASAAS_ENVIRONMENT="sandbox"
ASAAS_WEBHOOK_TOKEN="<asaas-webhook-token>"
